# Admin API: empty means same origin (the Vite proxy forwards /admin to commerce-core).
VITE_API_BASE_URL=
VITE_ADMIN_API_TARGET=http://localhost:8180
# Staff sign-in (ADR-0023): the Keycloak 'staff' realm from ecommerce-platform's docker compose --profile staff.
VITE_KEYCLOAK_ISSUER=http://localhost:8280/realms/staff
VITE_KEYCLOAK_CLIENT_ID=backoffice
